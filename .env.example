# ------------------------------------------------
# Environment variables for dvc_demo
# Copy this file to .env and fill in your values.
# ------------------------------------------------

# -- Heroku Deployment (used by CI/CD pipeline) --
HEROKU_API_TOKEN=your-heroku-api-token
HEROKU_APP_NAME=your-heroku-app-name

# -- Flask App --
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000

# -- Model Configuration (mirrors params.yaml) --
# These are documented here for reference; the app reads params.yaml directly.
# MODEL_ALPHA=0.85
# MODEL_L1_RATIO=0.83
# MODEL_DIR=saved_models
# WEBAPP_MODEL_DIR=prediction_service/model/model.joblib
# TARGET_COL=TARGET
# TEST_SIZE=0.2
# RANDOM_STATE=42
